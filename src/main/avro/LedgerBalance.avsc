{
  "type": "record",
  "name": "LedgerBalance",
  "namespace": "com.example.ledger.avro",
  "fields": [
    { "name": "tenantId", "type": "string" },
    { "name": "accountId", "type": "string" },
    { "name": "balance", "type": { "type": "bytes", "logicalType": "decimal", "precision": 19, "scale": 4 } },
    { "name": "currency", "type": "string" },
    { "name": "lastEventTime", "type": "long" }
  ]
}

