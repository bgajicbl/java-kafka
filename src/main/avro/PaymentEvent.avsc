{
  "type": "record",
  "name": "PaymentEvent",
  "namespace": "com.example.ledger.avro",
  "doc": "Command/event for the payment orchestration state machine lifecycle",
  "fields": [
    { "name": "paymentId", "type": "string" },
    { "name": "tenantId", "type": "string" },
    { "name": "accountId", "type": "string" },
    { "name": "amount", "type": { "type": "bytes", "logicalType": "decimal", "precision": 19, "scale": 4 } },
    { "name": "currency", "type": "string", "default": "USD" },
    { "name": "commandType", "type": {
      "type": "enum",
      "name": "PaymentCommandType",
      "symbols": ["INITIATE", "AUTHORIZE", "CAPTURE", "SETTLE", "REVERSE"]
    }},
    { "name": "correlationId", "type": ["null", "string"], "default": null },
    { "name": "eventTime", "type": "long" }
  ]
}

